# Copy to .env (`make setup` does this) and fill in real values. Never commit .env.

# --- Postgres (used by docker-compose and by the app) ---
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Admin connection: used only by scripts (data loading, indexing). The agent will get
# its own read-only role in Phase 1 and must never use this one.
DATABASE_URL=postgresql+psycopg://olist_admin:change-me@localhost:5432/olist

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Claude Opus 5.5 defaults to medium.
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
