# Copy to .env (`make setup` does this) and fill in real values. Never commit .env.

# --- Postgres (used by docker-compose and by the app) ---
POSTGRES_USER=olist_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olist
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Admin connection: used only by scripts (data loading, indexing). Never by the agent.
DATABASE_URL=postgresql+psycopg://olist_admin:change-me@localhost:5432/olist

# Read-only connection for the agent. `make load-data` creates this role with this password.
AGENT_DATABASE_URL=postgresql+psycopg://olist_agent:change-me-too@localhost:5432/olist

# --- LLM ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Claude Opus 5.5 defaults to medium.
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120

# Read-only connection to the retrieval index. `make build-index` creates this role.
RAG_DATABASE_URL=postgresql+psycopg://olist_rag:change-me-three@localhost:5432/olist

# --- Embeddings (retrieval) ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed

# --- Observability (Phase 5): tracing is off unless both keys are set ---
# Free tier: https://cloud.langfuse.com -> create a project -> Settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Demo protection and UI ---
# Writable connection for the spend counter only (`make setup-app-db` creates the role).
# APP_DATABASE_URL=postgresql+psycopg://olist_app:change-me-four@localhost:5432/olist
# DAILY_BUDGET_USD=1
# UI_MODE=api          # inprocess runs the agent inside Streamlit (Streamlit Community Cloud)
